# .env.example
# Copy this to .env in the same directory as docker-compose.yml and fill
# in your real key. Keep .env out of git (add it to .gitignore) - this is
# now the ONLY place the DQS key lives; it's never in the script or image.

SPAMHAUS_DQS_KEY=your_dqs_key_here
ZABBIX_SERVER=192.168.1.9
ZABBIX_HOST=spamhaus-monitor
TZ=Europe/Kyiv
RUN_AT=09:00
RUN_ON_START=false
